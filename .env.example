# ================================================================
# Electro Cuciné — variables de entorno (copia este archivo a .env)
# Ninguna de estas variables es obligatoria para desarrollo local:
# el backend funciona con los valores por defecto.
# ================================================================

# Puerto de la API (por defecto 3001)
PORT=3001

# development | production (en producción las cookies van con Secure)
NODE_ENV=development

# Orígenes permitidos por CORS, separados por coma.
# Si el frontend y la API se sirven desde el mismo origen (producción)
# no hace falta tocar esto.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001

# ---------- Superusuario (admin) inicial ----------
# Solo se usa la PRIMERA vez, cuando no existe un usuario con este nombre.
# Si ADMIN_PASSWORD está vacía, se genera una aleatoria y se muestra
# UNA vez por consola (anótala).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=

# Poné TRUST_PROXY=1 si hay un proxy inverso delante (nginx, IIS,
# Cloudflare) para que el rate limit use la IP real del cliente.
TRUST_PROXY=0

# Ruta alternativa de la base SQLite (los tests usan :memory:)
# EC_DB_PATH=BackEnd/data/electrocucine.db
